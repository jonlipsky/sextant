<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for the ProcessStack apps under apps/processstack/ only. Sextant.slnx never reads this
  file, so the public build needs no private feed.

  The private feed has no credentials here. Locally, NuGet merges the credentials that your user-level
  NuGet.Config stores under the SAME source key (see apps/processstack/README.md). In CI, the workflow adds
  them to the job's working copy of this file at run time, from a repository secret.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="elevenworks-github" value="https://nuget.pkg.github.com/elevenworks/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="elevenworks-github">
      <package pattern="ProcessStack.Abstractions" />
      <!-- The `processstack` CLI (dotnet tool) that validates and tests the app. -->
      <package pattern="ProcessStack.Cli" />
    </packageSource>
  </packageSourceMapping>
</configuration>
