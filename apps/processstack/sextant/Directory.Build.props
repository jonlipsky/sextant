<Project>
  <!--
    Build output for the app's projects goes outside the app directory (apps/processstack/artifacts/,
    git-ignored). `processstack app test` reads every .yaml/.yml/.json file under tests/ as a scenario, so
    the MSTest project's bin/ and obj/ JSON files must not land there. `app validate`/`app publish` also
    read the whole app directory. The bundle itself is still published to activities/sextant/ (build.sh).
  -->
  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)../artifacts</ArtifactsPath>
  </PropertyGroup>
</Project>
