<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile against the SDK only: the host supplies ProcessStack.Abstractions (and its logging
         dependency) at run time, so neither may be published into the app bundle. -->
    <PackageReference Include="ProcessStack.Abstractions" Version="1.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The app's own assembly, bundled with it: the same repository-URL code the service uses. -->
    <ProjectReference Include="..\..\..\..\..\src\Sextant.Core\Sextant.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sextant.ProcessStack.Activities.Tests" />
  </ItemGroup>

</Project>
